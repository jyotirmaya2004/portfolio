# Contact Form Email Configuration
# When EMAIL_API_KEY is unset, submissions are logged to the dev server terminal for testing.
# To send real emails, obtain a free API key from https://resend.com

# Target email where visitor messages should be delivered
CONTACT_EMAIL=jyotirmaya.behera@example.com

# Verified sender email address (e.g. from your custom domain or Resend test address)
FROM_EMAIL=onboarding@resend.dev

# Resend API Key (starts with re_...)
EMAIL_API_KEY=
